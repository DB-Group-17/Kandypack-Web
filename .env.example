# Database Connection (Aiven MySQL 8.0)
DATABASE_URL="mysql://<user>:<password>@<host>:<port>/<database>?ssl-mode=REQUIRED"

# Authentication (JWT Secret)
JWT_SECRET="your-256-bit-secret-here"

# Redis (Upstash REST API for caching, distributed locking, and rate-limiting)
UPSTASH_REDIS_REST_URL="https://<your-upstash-instance>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Environment
NODE_ENV="development"

# Seed script (development only) — shared password for the test role accounts
# created by `npm run db:seed` (Docs/06_seed-data-spec.md §12). No default: leave
# empty to skip creating the test accounts.
SEED_TEST_PASSWORD=""
